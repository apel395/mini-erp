datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String
  role      String   @default("USER")
  createdAt DateTime @default(now())
}

model Customer {
  id        String    @id @default(uuid())
  name      String
  email     String    @unique
  phone     String?
  address   String?
  invoices  Invoice[]
  createdAt DateTime  @default(now())
}

model Invoice {
  id          String        @id @default(uuid())
  invoiceNo   String        @unique
  status      String        @default("DRAFT")
  issueDate   DateTime      @default(now())
  dueDate     DateTime
  customerId  String
  customer    Customer      @relation(fields: [customerId], references: [id], onDelete: Restrict)
  items       InvoiceItem[]
  subTotal    Float
  taxTotal    Float
  grandTotal  Float
  createdAt   DateTime      @default(now())
}

model InvoiceItem {
  id          String   @id @default(uuid())
  invoiceId   String
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  description String
  quantity    Int
  price       Float
  total       Float
}